# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/taskflow_db"

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"
JWT_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
